# ==============================================================================
# 环境变量样例：复制为 .env 后按需修改
#   cp .env.example .env
#   （直接运行 ./scripts/deploy.sh 会在首次部署时自动完成这一步，
#     并写入一个随机的 APP_SECRET）
#
# docker compose 会自动读取同目录下的 .env 做变量替换，.env 不应提交到版本库。
# ==============================================================================

# ---------- 应用通用 ----------
TZ=Asia/Shanghai
# 运行模式：release（生产） / debug（开启 Swagger 文档）
APP_MODE=release
# 容器内监听端口
APP_PORT=1500
# 宿主机映射端口（被占用时改成 15001 之类）
HOST_PORT=1500
# 【必改】JWT 签名密钥。deploy.sh 会自动生成随机值；
# 手工部署时可用 openssl rand -base64 48 生成
APP_SECRET=change_me_please

# 注意：src/internal/app/bootstrap.go 里 HTTP 服务实际用的是
# fmt.Sprintf(":%d", port)，只取端口，因此 app.address 不生效，
# 进程在容器内始终监听 0.0.0.0。此项保留仅为兼容配置结构。
APP_ADDRESS=0.0.0.0

# ---------- 初始管理员账号 ----------
# 首次启动时，如果数据库里还没有任何用户，就会用下面这组账号自动建号，
# 于是「登录」即可，不必再点登录页上的「注册账号」。
#
# 留空 QLTOOLS_ADMIN_PASSWORD = 不自动建号，改用登录页的「注册账号」按钮自己注册。
# ./scripts/deploy.sh 首次生成 .env 时会自动填一个随机密码并打印出来。
#
# 用户名默认 admin
QLTOOLS_ADMIN_USERNAME=admin
# 【必改】管理员密码。建议只用字母数字，避免 $ " ' # 等字符被 compose 的变量替换吃掉
QLTOOLS_ADMIN_PASSWORD=

# 忘记密码时的补救开关：置 1 后 docker compose up -d 重启一次，
# 已存在的同名账号密码会被重置为上面的 QLTOOLS_ADMIN_PASSWORD；
# 重置完请把这里改回 0，否则每次重启都会把密码改回去。
QLTOOLS_ADMIN_RESET=0

# ---------- 镜像来源（部署端最关键的两项）----------
# 指向你已经推送好的镜像仓库。
# 留空则 deploy.sh 会用本地内嵌源码构建（需要本机有 Docker，无需联网拉镜像）。
# 云端构建（GitHub Actions）产出的镜像默认放在 <Docker Hub 用户名>/qltoolsv2。
IMAGE_REPO=chungg/qltoolsv2
IMAGE_TAG=latest
# 想锁定版本或回滚时，把上面改成版本标签（如 SHA-0915-V1.0）
# 或提交标签（如 sha-a3b9fbf），然后 docker compose pull && docker compose up -d
# 标签命名规则见 DEPLOY.md 第二节。
# 多架构构建时使用（配合 ./scripts/build-push.sh --platforms），
# 例如 linux/amd64,linux/arm64；单架构留空即可
PLATFORMS=

# ---------- 构建期参数 ----------
# Go 模块代理：国内用 goproxy.cn，海外可改为 https://proxy.golang.org,direct
GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct

# ---------- MySQL（docker-compose.mysql.yml）----------
MYSQL_DATABASE=ql_tools_v2
MYSQL_USER=qltools
MYSQL_PASSWORD=qltools_password
MYSQL_ROOT_PASSWORD=root_password_change_me

# ---------- PostgreSQL（docker-compose.postgres.yml）----------
POSTGRES_DB=ql_tools_v2
POSTGRES_USER=qltools
POSTGRES_PASSWORD=qltools_password
